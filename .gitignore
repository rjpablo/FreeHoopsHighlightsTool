# Private Python environment created by install.bat (PyTorch, Ultralytics, OpenCV, ...)
.venv/

# Bytecode and packaging leftovers
__pycache__/
*.py[cod]
*.egg-info/
dist/

# Downloaded detection weights (yolov8n/s copies and yolov8m/x fetched on first use)
models/*.pt
models/*.part
*.pt

# Downloaded FFmpeg binaries (gyan.dev). Fonts (DejaVu Sans) are tracked in git.
runtime/ffmpeg.exe
runtime/ffprobe.exe

# Intermediate WAVs from tools/make_music.py (m4a beats are tracked in git)
assets/music/*.wav

# Files the program writes while it runs
output/
logs/
work/
*.log
FreeHoopsHighlightsTool.settings.json
